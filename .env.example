# Copy file này thành .env trước khi chạy (hoặc dùng docker-compose.yml đã cấu hình sẵn)
# Không commit file .env thật lên git

# ── Bảo mật ───────────────────────────────────────────────────────────────────
JWT_SECRET=cab-system-super-secret-key-change-me

# ── Infrastructure ────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/<service>_db
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672

# ── API Gateway (port duy nhất expose ra ngoài) ───────────────────────────────
API_GATEWAY_PORT=3000

# ── Services — REST ports ─────────────────────────────────────────────────────
AUTH_SERVICE_PORT=4010
AUTH_SERVICE_URL=http://localhost:4010

CUSTOMER_SERVICE_PORT=4001
CUSTOMER_SERVICE_URL=http://localhost:4001

DRIVER_SERVICE_PORT=4002
DRIVER_SERVICE_URL=http://localhost:4002

BOOKING_SERVICE_PORT=4003
BOOKING_SERVICE_URL=http://localhost:4003

DISPATCH_SERVICE_PORT=4004
DISPATCH_SERVICE_URL=http://localhost:4004

LOCATION_SERVICE_PORT=4005
LOCATION_SERVICE_URL=http://localhost:4005

PRICING_SERVICE_PORT=4006
PRICING_SERVICE_URL=http://localhost:4006

PAYMENT_SERVICE_PORT=4007
PAYMENT_SERVICE_URL=http://localhost:4007

NOTIFICATION_SERVICE_PORT=4008
NOTIFICATION_SERVICE_URL=http://localhost:4008

ADMIN_SERVICE_PORT=4009
ADMIN_SERVICE_URL=http://localhost:4009

TRIP_SERVICE_PORT=4011
TRIP_SERVICE_URL=http://localhost:4011

# ── Services — gRPC ports ─────────────────────────────────────────────────────
AUTH_GRPC_URL=auth-service:5010
CUSTOMER_GRPC_URL=customer-service:5001
DRIVER_GRPC_URL=driver-service:5002
BOOKING_GRPC_URL=booking-service:5003
DISPATCH_GRPC_URL=dispatch-service:5004
LOCATION_GRPC_URL=location-service:5005
PRICING_GRPC_URL=pricing-service:5006
PAYMENT_GRPC_URL=payment-service:5007
NOTIFICATION_GRPC_URL=notification-service:5008
ADMIN_GRPC_URL=admin-service:5009
TRIP_GRPC_URL=trip-service:5011

# ── RabbitMQ event bus ────────────────────────────────────────────────────────
# SERVICE_NAME dùng để đặt tên queue durable: <SERVICE_NAME>.<event>
SERVICE_NAME=<tên-service>

# ── Tuning (tùy chỉnh) ────────────────────────────────────────────────────────
DISPATCH_OFFER_TIMEOUT_SEC=300
LOCATION_STALE_SEC=0
