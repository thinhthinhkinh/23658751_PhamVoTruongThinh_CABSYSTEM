# Phải khớp CHÍNH XÁC với JWT_SECRET mà backend cab-system đang chạy dùng
# (xem file .env của project cab-system, mặc định theo .env.example ở đó)
JWT_SECRET=cab-system-super-secret-key-change-me

# Base URL của API Gateway đang chạy
BASE_URL=http://localhost:3000/api/v1

# Phải khớp với DISPATCH_OFFER_TIMEOUT_SEC của dispatch-service container (CI override = 3)
DISPATCH_OFFER_TIMEOUT_SEC=3
